# Model Configuration
MODEL_PATH=models/best.pt
FALLBACK_MODEL_PATH=yolov8n.pt
CONF_THRESHOLD=0.50

# Temporal Filtering
CONFIRM_FRAMES=5
WINDOW_SIZE=10

# Alert Settings
ALERT_COOLDOWN_SEC=30
LOCAL_ALARM_ENABLED=True
TELEGRAM_ALERT_ENABLED=False

# Telegram Secrets (leave blank or fill with your credentials)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Storage & Database
DB_PATH=events.db
SNAPSHOT_DIR=snapshots
